rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Product Images ─────────────────────────────────────────────────────
    // Public read so images load in the iOS app without auth.
    // Authenticated write so the admin portal can upload product images.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Store Images ───────────────────────────────────────────────────────
    // Same: public read, authenticated write.
    match /stores/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── User Avatars / Profile Images ──────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
