rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Stores ─────────────────────────────────────────────────────────────
    // Public read so the iOS app can browse stores without requiring login.
    // Write requires Firebase Auth (admin portal users are always logged in).
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Products ───────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /availability/{availabilityId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Config ─────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Each user can read/write their own document.
    // Any authenticated user (admin portal) can read all user documents.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    // Authenticated users can create orders.
    // Any authenticated user can read/update all orders (covers admin portal).
    // Users can only read/update their own orders from the iOS app.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }
  }
}
