rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Stores ─────────────────────────────────────────────────────────────
    // Public read so the iOS app can browse stores without requiring login.
    // Write requires Firebase Auth (admin portal users are always logged in).
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Products ───────────────────────────────────────────────────────────
    // Same pattern: public read, authenticated write.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Stock availability sub-collection (written by Cloud Functions)
      match /availability/{availabilityId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Each user can only read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    // Authenticated users can create orders.
    // Users can read and update only their own orders.
    // Admin portal (any authenticated user) can read all orders for the dashboard.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || request.auth != null);
    }
  }
}
